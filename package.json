{
  "name": "esp32-cam-project",
  "version": "1.0.0",
  "description": "ESP32 CAM embedded coding and web server project with Vercel Web Interface",
  "main": "index.js",
  "scripts": {
    "build": "mkdir -p dist && cp -r public/* dist/",
    "start": "npx serve dist",
    "build:esp32": "platformio run -e esp32-cam",
    "upload": "platformio run -e esp32-cam -t upload",
    "monitor": "platformio device monitor -e esp32-cam --baud 115200",
    "clean": "platformio run -e esp32-cam -t clean",
    "install-libs": "platformio lib install"
  },
  "keywords": [
    "esp32",
    "embedded",
    "camera",
    "iot",
    "vercel",
    "fomo",
    "object-detection"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "platformio": "^6.1.11",
    "serve": "^14.2.0"
  }
}
